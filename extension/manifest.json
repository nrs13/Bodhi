{
  "manifest_version": 3,
  "name": "Bodhi - Vocabulary Assistant",
  "version": "1.0.0",
  "description": "Learn difficult words while watching YouTube videos without pausing",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://www.dictionaryapi.com/*",
    "https://api.wordnik.com/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["styles/fonts.css", "styles/widget.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Doto-Regular.ttf",
        "fonts/Doto-Bold.ttf",
        "styles/fonts.css",
        "styles/widget.css",
        "dict/index.aff",
        "dict/index.dic"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bodhi"
  }
}
